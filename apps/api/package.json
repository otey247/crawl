{
  "name": "@crawl/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "build": "tsc -p tsconfig.json && rm -rf dist/db/migrations && cp -r src/db/migrations dist/db/migrations",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "db:migrate": "tsx --env-file-if-exists=.env src/db/migrate.ts",
    "db:seed": "tsx --env-file-if-exists=.env src/db/seed.ts",
    "venues:import": "tsx --env-file-if-exists=.env src/scripts/import-osm.ts",
    "worker": "node --env-file-if-exists=.env dist/worker.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "latest",
    "@crawl/core": "*",
    "@fastify/cors": "^10.0.1",
    "@fastify/jwt": "^9.0.1",
    "@fastify/rate-limit": "^10.2.1",
    "@socket.io/redis-adapter": "^8.3.0",
    "bullmq": "^5.34.0",
    "fastify": "^5.2.0",
    "fastify-plugin": "^5.1.0",
    "ioredis": "^5.4.2",
    "luxon": "^3.5.0",
    "opening_hours": "^3.8.0",
    "pg": "^8.13.1",
    "sharp": "^0.33.5",
    "socket.io": "^4.8.1",
    "web-push": "^3.6.7",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/luxon": "^3.4.2",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "@types/web-push": "^3.6.4",
    "socket.io-client": "^4.8.1",
    "tsx": "^4.19.2",
    "vitest": "^2.1.8"
  }
}
