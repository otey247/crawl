DATABASE_URL=postgres://crawl:crawl@localhost:5432/crawl
REDIS_URL=redis://localhost:6379
JWT_SECRET=change-me
APP_URL=http://localhost:5173
API_URL=http://localhost:4000
CORS_ORIGINS=http://localhost:5173

# Route explanations + free-text routing preferences (optional; template fallback without it)
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5

# Walking router. VALHALLA_URL = self-hosted Valhalla (honours quieter/scenic costing).
# Otherwise the OSRM foot profile at OSRM_URL is used, with a straight-line estimate as fallback.
VALHALLA_URL=
# OSRM_URL=https://routing.openstreetmap.de/routed-foot
# OVERPASS_URL=https://overpass-api.de/api/interpreter

# Dev sign-in as seeded users (defaults to on outside production)
# DEV_LOGIN=true
# INLINE_WORKERS=true
